PORT=5000
NODE_ENV=development

# Firebase
FIREBASE_SERVICE_ACCOUNT='{...json...}'
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key

# Auth
JWT_SECRET=generate-a-strong-random-secret-min-32-chars
JWT_EXPIRY=12h

# EmailJS template: recipient {{email}}, code {{otp}}, expiry {{time}}; valid for 5 minutes.
EMAILJS_SERVICE_ID=your-service-id
EMAILJS_TEMPLATE_ID=your-template-id
EMAILJS_PUBLIC_KEY=your-public-key
EMAILJS_PRIVATE_KEY=your-private-key

# OpenRouter. Gemini 2.5 Flash drafts reliable Bloom-L3 JSON; free models were rate-limited or truncated.
OPENROUTER_API_KEY=your-openrouter-api-key
AI_EXTRACTION_MODEL=google/gemini-2.5-flash-lite
AI_GENERATION_MODEL=google/gemini-2.5-flash
AI_MAX_ATTEMPTS=3
AI_TIMEOUT_MS=90000
AI_MIN_INTERVAL_MS=1200

# Provision these existing Storage buckets: syllabi, notes, source_files, images.
# Keep syllabi/notes/source_files private; images need readable URLs for printing.
# Syllabus upload starts 300 review candidates in batches of 10.
# Each run is capped at 90 logical calls and a 1.5M conservative token bound;
# actual usage and cost are recorded in the generation job.
